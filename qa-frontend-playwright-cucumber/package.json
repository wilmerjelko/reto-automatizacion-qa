{
  "name": "qa-frontend-playwright-cucumber",
  "version": "1.0.0",
  "description": "Suite de pruebas automatizadas para el reto Frontend usando Playwright y Cucumber.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:login": "cucumber-js --tags @login",
    "test:checkout": "cucumber-js --tags @checkout",
    "test:headed": "cross-env HEADLESS=false SLOW_MO=250 cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "report": "node generate-report.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "gherkin",
    "qa",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "cross-env": "^10.1.0",
    "multiple-cucumber-html-reporter": "^3.6.2"
  }
}
